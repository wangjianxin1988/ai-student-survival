---
export const prerender = false;

// Required for dynamic route validation in hybrid mode
export function getStaticPaths() {
  return [];
}

import Layout from '@/layouts/Layout.astro';
import type { Tool } from '@/lib/supabase';
import FavoriteButton from '@/components/favorites/FavoriteButton';
import StarRating from '@/components/ratings/StarRating';
import CompareButton from '@/components/compare/CompareButton';
import ShareButton from '@/components/common/ShareButton';
import LikeButton from '@/components/common/LikeButton';
import CommentSection from '@/components/user/CommentSection';
import ToolPricingRealtime from '@/components/tools/ToolPricingRealtime';
import UpdateNotesClient from '@/components/tools/UpdateNotesClient';
import { getToolBySlug, getRelatedTools, staticTools } from '@/data/static-tools';

const { slug } = Astro.params;

// 数据已迁移到 src/data/static-tools.ts（2026-08-26 升级，65 个工具含 details）
const tool = getToolBySlug(slug as string);



if (!tool) {
  return Astro.redirect('/tools');
}

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": ["Product", "SoftwareApplication"],
    "name": tool.name,
    "description": tool.description,
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "url": tool.url,
    "image": tool.imageUrl,
    "brand": {
      "@type": "Brand",
      "name": tool.name
    },
    "offers": {
      "@type": "Offer",
      "price": tool.priceDetail.monthly?.toString() || "0",
      "priceCurrency": tool.priceDetail.currency,
      "availability": "https://schema.org/InStock",
      "priceType": "starting from"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": tool.rating.toString(),
      "reviewCount": tool.ratingCount.toString(),
      "ratingExplanation": `${tool.rating} out of 5 stars based on ${tool.ratingCount} reviews`
    },
    "featureList": tool.features.join(', '),
    "keywords": tool.tags.join(', '),
    "category": tool.category,
    "additionalProperty": [
      {
        "@type": "PropertyValue",
        "name": "easeOfUse",
        "value": tool.dimensions.easeOfUse.toString()
      },
      {
        "@type": "PropertyValue",
        "name": "features",
        "value": tool.dimensions.features.toString()
      },
      {
        "@type": "PropertyValue",
        "name": "value",
        "value": tool.dimensions.value.toString()
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://www.mi-to-ai.com/tools/${tool.slug}`
    },
    "headline": `${tool.name} - AI工具完全指南`,
    "description": tool.description,
    "author": {
      "@type": "Person",
      "name": "MI TO AI编辑团队"
    },
    "datePublished": tool.createdAt || "2025-01-15",
    "dateModified": tool.updatedAt || "2026-05-29",
    "publisher": {
      "@id": "https://www.mi-to-ai.com/#org"
    },
    "about": {
      "@type": "Product",
      "name": tool.name,
      "description": tool.description
    },
    "image": tool.imageUrl
  },
  // FAQPage Schema
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `${tool.name}免费版和付费版有什么区别？`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tool.pricing === 'free'
            ? `${tool.name}目前完全免费使用。`
            : tool.pricing === 'freemium'
              ? `${tool.name}提供免费版和付费版。免费版包含基础功能，付费版（$${tool.priceDetail.monthly}/月起）解锁更多高级特性，包括更强的模型能力、更高的使用额度和优先访问权。`
              : `${tool.name}是付费工具，$${tool.priceDetail.monthly}/月起，提供完整功能体验。`
        }
      },
      {
        "@type": "Question",
        "name": `留学生可以使用${tool.name}吗？`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `是的，留学生可以使用${tool.name}。但请注意你所在大学的AI使用政策，部分课程可能限制AI工具的使用。建议查看学校的具体规定，在允许的范围内合理使用。`
        }
      },
      {
        "@type": "Question",
        "name": `${tool.name}的支付方式有哪些？`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tool.pricing === 'free'
            ? `${tool.name}免费使用，无需支付。`
            : `订阅${tool.name}可使用国际信用卡、虚拟卡（如Depay、Noble）、礼品卡等支付方式。中国用户还可通过低价区注册享受更优惠的价格。详见我们的支付解决方案页面。`
        }
      }
    ]
  },
  // HowTo Schema
  ...(tool.details?.howToUse ? [{
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": `如何使用${tool.name}`,
    "description": `一步步教你使用${tool.name}的完整指南`,
    "totalTime": "PT15M",
    "tool": [
      {
        "@type": "HowToTool",
        "name": tool.name
      }
    ],
    "step": tool.details.howToUse.map((step: {step: number; title: string; description: string}) => ({
      "@type": "HowToStep",
      "position": step.step,
      "name": step.title,
      "text": step.description
    }))
  }] : [])
];
---

<Layout
  title={tool.name}
  description={tool.description}
  image={tool.imageUrl}
  type="article"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: '首页', href: '/' },
    { name: 'AI工具库', href: '/tools' },
    { name: tool.name }
  ]}
>

  <!-- Breadcrumb -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <nav class="flex items-center gap-2 text-sm flex-wrap">
          <a href="/" class="text-gray-500 hover:text-gray-900">首页</a>
          <span class="text-gray-400">/</span>
          <a href="/tools" class="text-gray-500 hover:text-gray-900">AI工具库</a>
          <span class="text-gray-400">/</span>
          <span class="text-gray-900 font-medium truncate max-w-[200px] sm:max-w-none">{tool.name}</span>
        </nav>
        <button
          id="back-to-tools"
          onclick="const isEn = window.location.pathname.startsWith('/en'); window.location.href = isEn ? '/en/tools' : '/tools';"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-sm font-medium flex-shrink-0"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          返回列表
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2 min-w-0">
        <!-- Hero Image -->
        <div class="rounded-xl overflow-hidden mb-8">
          <img src={tool.imageUrl} alt={tool.name} class="w-full h-auto" />
        </div>

        <!-- Title Section -->
        <div class="mb-8">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
            <div class="flex items-center gap-3 min-w-0">
              <h1 class="text-2xl sm:text-3xl font-bold truncate">{tool.name}</h1>
              {tool.isNew && <span class="badge bg-red-100 text-red-700 flex-shrink-0">新收录</span>}
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <FavoriteButton client:load targetType="tool" targetId={tool.slug} locale="zh" />
              <LikeButton client:load targetType="tool" targetId={tool.slug} locale="zh" />
              <ShareButton client:load title={tool.name} description={tool.description} targetType="tool" targetId={tool.slug} />
              <button
                id="copy-link-btn"
                aria-label="复制链接"
                onclick="navigator.clipboard.writeText(window.location.href).then(() => { const btn = document.getElementById('copy-link-btn'); if(btn) { btn.textContent = '已复制!'; setTimeout(() => { if(btn) btn.textContent = '复制链接'; }, 2000); } })"
                class="p-2 rounded-lg text-gray-400 hover:text-gray-600 bg-gray-50 hover:bg-gray-100 transition-colors"
                title="复制链接"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              </button>
            </div>
          </div>
          <p class="text-base sm:text-lg text-gray-600">{tool.description}</p>
        </div>

        <!-- Features -->
        <section class="mb-8">
          <h2 class="text-xl font-semibold mb-4">核心功能</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {tool.features.map(feature => (
              <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg min-w-0">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm">{feature}</span>
              </div>
            ))}
          </div>
        </section>


        {/* Pricing Comparison Table - Only for ChatGPT and Claude */}
        {(tool.slug === 'chatgpt' || tool.slug === 'claude') && (
          <section class="mb-8">
            <h2 class="text-xl font-semibold mb-4">套餐对比</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm border border-gray-200 rounded-xl overflow-hidden">
                <thead>
                  <tr class="bg-gray-50">
                    <th class="text-left p-3 font-semibold">套餐</th>
                    <th class="text-left p-3 font-semibold">月费</th>
                    <th class="text-left p-3 font-semibold">模型</th>
                    <th class="text-left p-3 font-semibold">上下文</th>
                    <th class="text-left p-3 font-semibold">推荐场景</th>
                  </tr>
                </thead>
                <tbody>
                  {tool.slug === 'chatgpt' ? (
                    <>
                      <tr class="border-t border-gray-100">
                        <td class="p-3 font-medium">Free</td>
                        <td class="p-3">$0</td>
                        <td class="p-3">GPT-5.3 Instant</td>
                        <td class="p-3">标准</td>
                        <td class="p-3 text-gray-600">轻度体验</td>
                      </tr>
                      <tr class="border-t border-gray-100 bg-green-50">
                        <td class="p-3 font-medium">Go ⭐</td>
                        <td class="p-3">$8/月</td>
                        <td class="p-3">GPT-5.3 Instant</td>
                        <td class="p-3">标准</td>
                        <td class="p-3 text-gray-600">学生日常</td>
                      </tr>
                      <tr class="border-t border-gray-100">
                        <td class="p-3 font-medium">Plus</td>
                        <td class="p-3">$20/月</td>
                        <td class="p-3">GPT-5.5 Thinking</td>
                        <td class="p-3">128K</td>
                        <td class="p-3 text-gray-600">专业用户</td>
                      </tr>
                      <tr class="border-t border-gray-100">
                        <td class="p-3 font-medium">Pro $100</td>
                        <td class="p-3">$100/月</td>
                        <td class="p-3">GPT-5.5 Pro</td>
                        <td class="p-3">256K</td>
                        <td class="p-3 text-gray-600">开发者/研究</td>
                      </tr>
                      <tr class="border-t border-gray-100">
                        <td class="p-3 font-medium">Pro $200</td>
                        <td class="p-3">$200/月</td>
                        <td class="p-3">GPT-5.5 Pro</td>
                        <td class="p-3">1M</td>
                        <td class="p-3 text-gray-600">企业/重度使用</td>
                      </tr>
                    </>
                  ) : (
                    <>
                      <tr class="border-t border-gray-100">
                        <td class="p-3 font-medium">Free</td>
                        <td class="p-3">$0</td>
                        <td class="p-3">Claude Sonnet</td>
                        <td class="p-3">标准</td>
                        <td class="p-3 text-gray-600">轻度体验</td>
                      </tr>
                      <tr class="border-t border-gray-100 bg-purple-50">
                        <td class="p-3 font-medium">Pro ⭐</td>
                        <td class="p-3">$20/月</td>
                        <td class="p-3">Claude Sonnet + Opus</td>
                        <td class="p-3">200K</td>
                        <td class="p-3 text-gray-600">日常重度使用</td>
                      </tr>
                      <tr class="border-t border-gray-100">
                        <td class="p-3 font-medium">Team</td>
                        <td class="p-3">$30/人/月</td>
                        <td class="p-3">全模型 + 团队协作</td>
                        <td class="p-3">200K</td>
                        <td class="p-3 text-gray-600">团队协作</td>
                      </tr>
                      <tr class="border-t border-gray-100">
                        <td class="p-3 font-medium">Enterprise</td>
                        <td class="p-3">定制</td>
                        <td class="p-3">全模型 + SSO</td>
                        <td class="p-3">200K+</td>
                        <td class="p-3 text-gray-600">企业定制</td>
                      </tr>
                    </>
                  )}
                </tbody>
              </table>
            </div>
            <p class="text-xs text-gray-500 mt-2">* 价格可能因地区和汇率变动，请以官网为准</p>
          </section>
        )}

        <!-- Rating Details -->
        <section class="mb-8">
          <h2 class="text-xl font-semibold mb-4">评分详情</h2>
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <div class="flex items-center gap-4 mb-6">
              <div class="text-5xl font-bold text-primary-600">{tool.rating}</div>
              <div>
                <div class="rating mb-2">
                  <StarRating client:load targetType="tool" targetId={tool.slug} size="lg" />
                </div>
                <p class="text-sm text-gray-500">{tool.ratingCount} 条评价</p>
              </div>
            </div>

            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium">易用性</span>
                <div class="flex items-center gap-2">
                  <div class="w-32 h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full bg-primary-500 rounded-full" style={`width: ${tool.dimensions.easeOfUse * 20}%`}></div>
                  </div>
                  <span class="text-sm font-medium w-8">{tool.dimensions.easeOfUse}</span>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium">功能丰富度</span>
                <div class="flex items-center gap-2">
                  <div class="w-32 h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full bg-secondary-500 rounded-full" style={`width: ${tool.dimensions.features * 20}%`}></div>
                  </div>
                  <span class="text-sm font-medium w-8">{tool.dimensions.features}</span>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium">性价比</span>
                <div class="flex items-center gap-2">
                  <div class="w-32 h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full bg-green-500 rounded-full" style={`width: ${tool.dimensions.value * 20}%`}></div>
                  </div>
                  <span class="text-sm font-medium w-8">{tool.dimensions.value}</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Alternatives -->
        {(() => {
          // Build a slug -> name lookup from all defined tools
          const altNames = {};
          staticTools.forEach((t) => { altNames[t.slug] = t.name; });
          // Only show alternatives that exist in our data
          const validAlts = tool.alternatives.filter(a => altNames[a]);
          if (validAlts.length === 0) return null;
          return (
            <section>
              <h2 class="text-xl font-semibold mb-4">替代工具</h2>
              <div class="flex flex-wrap gap-2">
                {validAlts.map(alt => (
                  <a href={`/tools/${alt}`} class="btn-outline text-sm">
                    {altNames[alt]}
                  </a>
                ))}
              </div>
            </section>
          );
        })()}

        {/* Comments Section */}
        <section class="mt-12">
          <CommentSection client:visible targetType="tool" targetId={tool.slug} locale="zh" showRating={true} />
        </section>

        <!-- Capability Expansion -->
        <section class="mt-8">
          <h2 class="text-xl font-semibold mb-4">能力拓展</h2>
          <div class="bg-gradient-to-r from-primary-50 to-blue-50 rounded-xl border border-primary-100 p-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {tool.features.slice(0, 4).map((feature, idx) => (
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-full bg-primary-100 text-primary-600 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="font-medium text-gray-900">{feature}</h4>
                    <p class="text-sm text-gray-600 mt-1">
                      {idx === 0 ? '点击了解该能力的详细应用场景' :
                       idx === 1 ? '查看该能力在实际使用中的表现' :
                       idx === 2 ? '探索该能力如何提升工作效率' :
                       '了解该能力的最新更新和优化'}
                    </p>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-4 pt-4 border-t border-primary-100">
              <p class="text-sm text-gray-600">
                <span class="font-medium text-primary-700">提示：</span>
                大多数AI工具支持API接入，您可以根据需要在第三方应用或自动化工作流中集成使用。
                {tool.pricing === 'free' || tool.pricing === 'freemium' ? '该工具提供免费版本，建议先体验再决定是否付费升级。' : '付费版本通常提供更高的使用限额和更多高级功能。'}
              </p>
            </div>
          </div>
        </section>

        <!-- Update Notes -->
        <section class="mt-8">
          <h2 class="text-xl font-semibold mb-4">更新说明</h2>
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-lg bg-green-100 text-green-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">最新更新</p>
              </div>
            </div>
            {tool.updateSourceUrl ? (
              <UpdateNotesClient
                client:load
                slug={tool.slug}
                sourceUrl={tool.updateSourceUrl}
                sourceType={tool.updateSourceType}
              />
            ) : tool.details?.updateNotes ? (
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <div class="w-2 h-2 rounded-full bg-green-500 mt-2 flex-shrink-0"></div>
                  <p class="text-sm text-gray-700">{tool.details.updateNotes}</p>
                </div>
              </div>
            ) : (
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <div class="w-2 h-2 rounded-full bg-green-500 mt-2 flex-shrink-0"></div>
                  <p class="text-sm text-gray-700">工具评分和评价数据基于用户反馈定期更新</p>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-2 h-2 rounded-full bg-blue-500 mt-2 flex-shrink-0"></div>
                  <p class="text-sm text-gray-700">功能列表和定价信息可能因官方更新而变化，建议以官网为准</p>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-2 h-2 rounded-full bg-purple-500 mt-2 flex-shrink-0"></div>
                  <p class="text-sm text-gray-700">如发现信息有误，欢迎通过评论区反馈给我们</p>
                </div>
              </div>
            )}
          </div>
        </section>

        <!-- How to Get Started -->
        <section class="mt-8">
          <h2 class="text-xl font-semibold mb-4">如何使用{tool.name}</h2>
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            {tool.details?.howToUse ? (
              <div class="space-y-4">
                {tool.details.howToUse.map((step) => (
                  <div class="flex gap-4">
                    <div class="w-8 h-8 rounded-full bg-primary-100 text-primary-600 flex items-center justify-center font-semibold flex-shrink-0">{step.step}</div>
                    <div>
                      <h4 class="font-medium text-gray-900 mb-1">{step.title}</h4>
                      <p class="text-sm text-gray-600">{step.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="space-y-4">
                <div class="flex gap-4">
                  <div class="w-8 h-8 rounded-full bg-primary-100 text-primary-600 flex items-center justify-center font-semibold flex-shrink-0">1</div>
                  <div>
                    <h4 class="font-medium text-gray-900 mb-1">注册账户</h4>
                    <p class="text-sm text-gray-600">访问{tool.name}官网，点击注册按钮创建账户。使用邮箱或Google/Apple账号快速注册。</p>
                  </div>
                </div>
                <div class="flex gap-4">
